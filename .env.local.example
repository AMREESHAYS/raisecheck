# Supabase — from Project Settings → API in the Supabase dashboard.
# The service-role key bypasses RLS. Server-side only. Never expose it to the client,
# never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Groq retires models periodically; check the console if chat 400s.
GROQ_MODEL=llama-3.3-70b-versatile

# Any long random string. `openssl rand -hex 32`.
# Changing it resets every rate-limit window, which is fine.
IP_HASH_SALT=

# Apify — https://console.apify.com/settings/integrations
# Only needed for `npm run ingest`. The app never calls Apify at request time.
APIFY_TOKEN=
# Required to convert USD figures (levels.fyi global rows). Left unset, USD rows
# are dropped rather than converted at a stale hardcoded rate.
USD_INR=
