# --- Database -----------------------------------------------------------------
# Postgres connection string. Supabase, Neon, Railway or a local server all work.
# Leave it UNSET to use the embedded PGlite database in ./.pglite (zero setup,
# fine for local development and the test suite).
# DATABASE_URL=postgres://user:password@host:5432/saltor

# --- AI features --------------------------------------------------------------
# Without this key the app still runs: /api/chat and /api/negotiate return
# deterministic, data-only answers instead of generated prose.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for chat and negotiation drafts.
# SALTOR_MODEL=claude-opus-5
